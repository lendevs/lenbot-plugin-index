{
  "version": 1,
  "entries": [
    {
      "name": "asoul",
      "title": "A-SOUL 日程与动态",
      "description": "查询 A-SOUL 直播日程、历史同日、动态和二创，发送图文卡片；主人可在聊天中标记特别关注、调整开播前提醒。",
      "authors": [
        "LEN5010"
      ],
      "license": "AGPL-3.0-or-later",
      "version": "1.5.0",
      "interface": 1,
      "requires_lenbot": ">=0.2.1,<1",
      "category": "内容查询",
      "capabilities": [
        "日程与特别关注",
        "历史同日与二创",
        "昵称和分类筛选",
        "主 Agent 工具",
        "主题卡片"
      ],
      "usage": [
        "需要 LenBot 0.2.1；安装后选择启用的群。",
        "查询日程、动态、历史同日和二创，使用 asoul_send_card 发送图文卡片。",
        "主人用 asoul_schedule_highlight 管理单场特别关注，asoul_schedule_settings 调整全局开播前提醒。",
        "角色工具名单保留 live_schedule、asoul_dynamics、asoul_fanart、asoul_send_card、asoul_schedule_highlight、asoul_schedule_settings 和 tool_search。"
      ],
      "install": "git",
      "repository": "https://github.com/LEN5010/lenbot-plugin-asoul",
      "ref": "934aa5085c34f61fb1c23f28fb9e8309281b12fd",
      "permissions": [
        "send",
        "events",
        "configure"
      ]
    },
    {
      "name": "weather",
      "title": "天气预报",
      "description": "查询配置地点的天气；异常预报作为事件交给对话，不直接发送消息。",
      "authors": [
        "xueyutan"
      ],
      "license": "AGPL-3.0-or-later",
      "version": "1.0.0",
      "interface": 1,
      "requires_lenbot": ">=0.4.0,<1",
      "category": "生活工具",
      "capabilities": [
        "天气查询",
        "异常天气提醒"
      ],
      "usage": [
        "配置地点、经纬度及巡检时间。",
        "在要使用的场景启用。"
      ],
      "install": "git",
      "repository": "https://github.com/xueyutan/lenbot-plugin-weather.git",
      "homepage": "https://github.com/xueyutan/lenbot-plugin-weather",
      "ref": "65dd10cf9bbe4efedd83a437eb62a0e11e2f097e",
      "permissions": [
        "events"
      ]
    }
  ]
}
